{
  "manifest_version": 3,
  "name": "GWA Gah?",
  "short_name": "GWA Gah",
  "version": "2.1.0",
  "description": "A gamified GWA calculator for UM Davao students with Old/New grading system selector, rank system, progress bar, and grade reference.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.umindanao.edu.ph/student/spr*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}