{
  "manifest_version": 3,
  "name": "GradeGlow GWA Calculator",
  "short_name": "GradeGlow",
  "version": "1.2.0",
  "description": "A modern yellow-and-blue personal GWA calculator with a distinct GradeGlow identity for the UM Student Portal permanent-record page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.umindanao.edu.ph/student/spr*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}